POSTGRES_DB=kanban
POSTGRES_USER=kanban
POSTGRES_PASSWORD=replace_with_local_password
POSTGRES_PORT=5432

# Backend authentication settings (copy to the backend run configuration).
POSTGRES_HOST=localhost
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
AUTH_SESSION_RETENTION=7d
AUTH_CLEANUP_INTERVAL=1h
AUTH_CLEANUP_BATCH_SIZE=500
JWT_ISSUER=kanban-backend
JWT_AUDIENCE=kanban-api
JWT_PRIVATE_KEY_LOCATION=file:C:/kanban-secrets/access-private.pem
JWT_PUBLIC_KEY_LOCATION=file:C:/kanban-secrets/access-public.pem
JWT_CLOCK_SKEW=30s
APP_AUTH_COOKIE_SECURE=false
BCRYPT_STRENGTH=12
AUTH_RATE_LIMIT_REGISTER_ATTEMPTS=5
AUTH_RATE_LIMIT_REGISTER_WINDOW=1h
AUTH_RATE_LIMIT_LOGIN_IP_ATTEMPTS=30
AUTH_RATE_LIMIT_LOGIN_EMAIL_ATTEMPTS=10
AUTH_RATE_LIMIT_LOGIN_WINDOW=15m
AUTH_RATE_LIMIT_REFRESH_ATTEMPTS=120
AUTH_RATE_LIMIT_REFRESH_WINDOW=1m
AUTH_RATE_LIMIT_MAX_ENTRIES=10000
